# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Python packages under python/ (pure-Python, not Cargo crates).
# Generated gRPC stubs are build output regenerated from the canonical
# crates/mili-viz-proto/proto/mili_viz.proto — never committed
# (planning/mili-viz/phase-6-m1.md Decisions 36 & 53).
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
python/**/src/griz/_proto/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Large per-run artifacts: GEPA optimization sweeps and bench eval
# runs. Everything else under data/posttraining/ (catalog.yaml, eval
# scenarios, grammar/tools.json, synthesized scenarios, dataset_card.md,
# baselines, etc.) tracks normally.
data/posttraining/gepa-runs/
data/posttraining/runs/

# Stage-6 SFT corpus artifacts (sft/, pref/, eval/) are large generated
# JSONL — regenerated by `mili-llm-bench assemble` from the rollouts
# files. Only the dataset_card.md is tracked, per
# planning/mili-viz/mili-agent/posttraining-dataset.md §3.
data/posttraining/sft/sft/
data/posttraining/sft/pref/
data/posttraining/sft/eval/

# SFT training checkpoints: per-epoch HF saves + final/ — multi-GB each,
# reproducible from sft/sft/train.jsonl + scripts/sft_train.sbatch. Only
# the "winning" checkpoint's GGUF eventually ships; per-checkpoint dirs
# are intermediate artifacts.
data/posttraining/checkpoints/

# Training / job runtime logs (sbatch stdout, slurm stderr, ad-hoc
# nohup output). Regenerable from the source command line; commits
# would balloon over time.
logs/

# Claude Code harness state. `settings.json` and `hooks/` are tracked
# (project-level config); `settings.local.json` is per-user overrides
# and `scheduled_tasks.lock` is harness runtime state.
.claude/settings.local.json
.claude/scheduled_tasks.lock
